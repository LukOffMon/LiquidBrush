{
  "id": "./",
  "name": "Liquid Bullet",
  "short_name": "Liquid Bullet",
  "description": "Música que se derrite: tu reproductor web personal, surrealista y cromado.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#100d1c",
  "theme_color": "#100d1c",
  "categories": [
    "music",
    "entertainment"
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Buscar",
      "short_name": "Buscar",
      "url": "./?view=search",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Favoritas",
      "short_name": "Favoritas",
      "url": "./?view=favorites",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Biblioteca",
      "short_name": "Biblioteca",
      "url": "./?view=library",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Lab",
      "short_name": "Lab",
      "url": "./lab.html",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/movil-inicio.jpg",
      "sizes": "780x1688",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Inicio con tus playlists y mixes del día"
    },
    {
      "src": "screenshots/movil-sonando.jpg",
      "sizes": "780x1688",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Sonando a pantalla completa"
    },
    {
      "src": "screenshots/escritorio.jpg",
      "sizes": "1440x900",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Liquid Bullet en el escritorio"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
