# Lo crea instalar.sh. Si lo rellenas a mano, copia este archivo a .env.
# Dirección pública del puente (sin https://). Sin dominio propio: <IP-con-guiones>.sslip.io
DOMINIO=158-101-22-33.sslip.io
# Clave que pegas en Liquid (Ajustes → Liquid ATK → SKd). Larga y secreta.
LIQUID_CLAVE=
# Clave de API de slskd (solo la usa el puente; Liquid nunca la ve)
SLSKD_API_KEY=
# Usuario y contraseña del panel de slskd (por si la clave de API no basta)
SLSKD_WEB_USUARIO=liquid
SLSKD_WEB_CONTRASENA=
# Webs que pueden usar el puente (separadas por comas)
ORIGENES=https://lukoffmon.github.io
